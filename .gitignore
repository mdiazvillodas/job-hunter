# ============================================================================
# Job Hunter — .gitignore
# Excluye datos personales, secretos y artefactos locales del versionado.
# ============================================================================

# --- dependencias / build ---
node_modules/

# --- sesión de navegador / cookies de LinkedIn (NUNCA versionar) ---
browser-profile/
browser-profile-infojobs/
browser-profile-chrome/
browser-profile-firefox/
perfil_prueba_*/

# --- logs de runs y audit trail local ---
runs/

# --- datos generados: ofertas reales + feedback/decisiones personales ---
src/data/jobs/*.json
src/data/hunt.lock

# --- perfiles personales (CV, contexto, preferencias) ---
src/ai/marianoProfile.json
src/ai/marianoMatchingProfile.json
src/ai/marianoCareerContext.json
/Mariano_Diaz_Villodas_CV*.pdf

# --- secretos / entorno ---
.env
.env.*
!.env.example

# --- logs y temporales ---
*.log
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db
scratchpad/

# ============================================================================
# Se PERMITEN explícitamente (versionables) archivos como:
#   .env.example
#   src/data/jobs/.gitkeep      (conserva la carpeta vacía en el clon)
#   src/ai/*.example.json       (plantillas de perfil sin datos reales)
# ============================================================================

# --- estado local de runtime (offset de Telegram) ---
state/

# --- capturas de reconocimiento de InfoJobs (pueden incluir datos de sesion) ---
recon/

instances/
private-baseline/
dist/


# Acceso privado de Oracle: configuración generada, claves y sesión remota
oracle-private/
access-secrets/
**/.vnc-passwd
**/.vnc-password.txt

# Informes privados de pilotos reales: conservar solo localmente
docs/validation-pilot/resultados-reales-*
docs/validation-pilot/diagnostico-tecnico-cuatro-problemas.md
docs/validation-pilot/validacion-final-dirigida-*.md
docs/validation-pilot/cierre-simple-*.md
