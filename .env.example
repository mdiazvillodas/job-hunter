# ============================================================================
# Job Hunter — plantilla de variables de entorno.
# Copiar a .env (gitignored) o definirlas en el entorno de usuario de Windows
# con `setx NOMBRE "valor"`. El proyecto NO usa dotenv: las lee de process.env,
# y el trigger se las pasa al hunt que spawnea (env: process.env).
# NUNCA poner valores reales en este archivo.
# ============================================================================

# --- OpenAI (analyzer) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Trigger service (n8n dispara POST /run con este bearer token) ---
HUNT_TRIGGER_TOKEN=
# HUNT_TRIGGER_PORT=8787
# HUNT_TRIGGER_HOST=127.0.0.1

# --- Notificaciones push (ntfy) ---
# Side effect informativo: si NTFY_ENABLED no es exactamente "true", el hunt
# corre normalmente y no envia nada. Si esta en "true" pero falta/es invalido
# NTFY_TOPIC, se loguea el problema una vez y el hunt sigue igual.
#
# El umbral de "high match" (>= 90) NO es una variable de entorno: es una
# constante de dominio en src/notifications/ntfy.js (HIGH_MATCH_THRESHOLD),
# porque define que significa un match alto, no como se despliega.
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
# El topic de ntfy.sh es publico para quien lo conozca: tratalo como un secreto
# y no lo comitees. Si en el futuro se agrega auth, la credencial va aparte y
# tampoco se versiona.

# --- Limites de discovery/analisis (opcionales; ver src/config.js) ---
# MAX_RESULTS_PER_SEARCH=25
# MAX_PAGES_PER_SEARCH=2
# ANALYZE_LIMIT=50
# Headless por defecto. Descomentar solo para ver el navegador:
# HEADLESS=false
